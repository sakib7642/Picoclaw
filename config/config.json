{
  "version": 3,
  "agents": {
    "defaults": {
      "workspace": "/root/.picoclaw/workspace",
      "restrict_to_workspace": true,
      "max_tokens": 256,
      "context_window": 1024,
      "temperature": 0.7,
      "max_tool_iterations": 8,
      "max_parallel_turns": 1,
      "model_name": "mobilellm-376m"
    }
  },
  "model_list": [
    {
      "model_name": "mobilellm-376m",
      "provider": "openai",
      "model": "mobilellm-376m",
      "api_base": "http://127.0.0.1:8100/v1",
      "api_keys": ["local-router"],
      "request_timeout": 240,
      "enabled": true
    }
  ],
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "log_level": "info"
  },
  "channel_list": {},
  "tools": {
    "web": {"enabled": true},
    "exec": {"enabled": true},
    "skills": {"enabled": true},
    "read_file": {"enabled": true},
    "write_file": {"enabled": true},
    "list_dir": {"enabled": true}
  },
  "heartbeat": {"enabled": false},
  "devices": {"enabled": false}
}
