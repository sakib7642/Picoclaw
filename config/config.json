{
  "version": 3,
  "agents": {
    "defaults": {
      "workspace": "/root/.picoclaw/workspace",
      "restrict_to_workspace": true,
      "max_tokens": 512,
      "context_window": 4096,
      "temperature": 0.7,
      "max_tool_iterations": 8,
      "max_parallel_turns": 1,
      "model_name": "qwen3.5-0.8b"
    }
  },
  "model_list": [
    {
      "model_name": "qwen3.5-0.8b",
      "provider": "openai",
      "model": "qwen3.5-0.8b",
      "api_base": "http://127.0.0.1:8000/v1",
      "api_keys": [
        "local"
      ],
      "request_timeout": 180
    }
  ],
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "log_level": "info"
  },
  "channel_list": {},
  "tools": {
    "web": {
      "enabled": false
    },
    "exec": {
      "enabled": true
    },
    "skills": {
      "enabled": true
    },
    "read_file": {
      "enabled": true
    },
    "write_file": {
      "enabled": true
    },
    "list_dir": {
      "enabled": true
    }
  },
  "heartbeat": {
    "enabled": false
  },
  "devices": {
    "enabled": false
  }
}
